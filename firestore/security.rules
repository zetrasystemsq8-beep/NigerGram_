rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // users: only the authenticated owner may read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // wallets: owner may read/write their bank fields
    match /wallets/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // withdrawal_requests: creators can create their own requests; server updates status
    match /withdrawal_requests/{reqId} {
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
      allow read: if request.auth != null && resource.data.creatorId == request.auth.uid;
      allow update: if false; // server (admin SDK) updates status
      allow delete: if false;
    }

    // topup_requests: users create requests and may mark them as paid (receipt); only server/admin may approve
    match /topup_requests/{reqId} {
      // Creation: user may create a pending request for themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.centAmount is int
                    && request.resource.data.centAmount > 0;

      // Read: user who created it or admin users (custom claim 'admin')
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);

      // Update by owner: only allow marking as 'paid' and uploading a receipt. Prevent client-side approval.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.status == 'paid'
                    && (request.resource.data.keys().hasOnly(['userId','centAmount','nairaAmount','paymentCode','zetraAccount','receiptUrl','status','createdAt','updatedAt','adminId','adminNote','[...]

      // Disallow client-side approving/rejecting. Admin approvals should be performed with server-side admin SDK which bypasses rules.
      allow delete: if false;
    }

    // wallet_transactions: owners can read their transactions
    match /wallet_transactions/{txId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // monnify_webhook_audit: server-only
    match /monnify_webhook_audit/{docId} {
      allow write: if false;
      allow read: if false;
    }

    // New rule: config/topup — authenticated users can read; only admins can write
    match /config/topup {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
